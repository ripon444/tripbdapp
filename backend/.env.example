# TripBD - Bangladesh On-Demand Transport & Logistics Platform
# Environment Configuration Template for cPanel Deployment

APP_NAME=TripBD
APP_ENV=production
APP_KEY=base64:GENERATE_VIA_ARTISAN_KEY_GEN_OR_CPANEL_SETUP
APP_DEBUG=false
APP_URL=https://your-cpanel-domain.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# cPanel MySQL 8+ Database Setup
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cpaneluser_tripbd
DB_USERNAME=cpaneluser_tripbd_user
DB_PASSWORD=YOUR_STRONG_DATABASE_PASSWORD

# Drivers (Native cPanel / Shared Hosting - No Redis required)
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Google Maps Platform (Directions, Geocoding, Distance Matrix)
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_KEY_HERE

# SMS / OTP Provider (Bangladeshi Gateways)
SMS_GATEWAY_PROVIDER=greenweb
SMS_API_KEY=YOUR_SMS_GATEWAY_KEY
SMS_SENDER_ID=TripBD

# cPanel SMTP Mail Configuration
MAIL_MAILER=smtp
MAIL_HOST=mail.your-cpanel-domain.com
MAIL_PORT=465
MAIL_USERNAME=noreply@your-cpanel-domain.com
MAIL_PASSWORD=YOUR_CPANEL_EMAIL_PASSWORD
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=noreply@your-cpanel-domain.com
MAIL_FROM_NAME="${APP_NAME}"

# Payment Gateway Configuration (Strict Sandbox Mode by Default)
PAYMENT_ENV=sandbox

# bKash Tokenized Checkout (Sandbox credentials or add live credentials when verified)
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_CALLBACK_URL=https://your-cpanel-domain.com/api/v1/payments/bkash/callback

# Nagad Merchant Gateway (Sandbox)
NAGAD_MERCHANT_ID=
NAGAD_PUBLIC_KEY=
NAGAD_PRIVATE_KEY=
NAGAD_BASE_URL=http://sandbox.mynagad.com:10080/remote-payment-gateway-1.0/api/dfs
NAGAD_CALLBACK_URL=https://your-cpanel-domain.com/api/v1/payments/nagad/callback

# DBBL Rocket Enterprise Merchant
ROCKET_MERCHANT_ID=
ROCKET_BASE_URL=https://sandbox.dutchbanglabank.com/rocket

# SSLCOMMERZ Hosted Card Gateway (Visa, Mastercard, Amex, MFS)
CARD_GATEWAY=sslcommerz
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASS=

# Platform Financial Settings (Defaults)
PLATFORM_COMMISSION_PERCENT=15.00
MINIMUM_WITHDRAWAL=500.00
MAXIMUM_WITHDRAWAL=50000.00
CURRENCY=BDT
